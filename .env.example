# Copy this file to .env locally and fill in your own values.
# In Vercel, configure these under Project Settings -> Environment Variables.

# Required for Gemini-powered exam question extraction and answer generation.
GEMINI_API_KEY=

# Required for persistent sessions, staff data, and evaluated answer sheets.
# Use a NEW MongoDB Atlas database-user password; rotate any credential previously committed.
MONGODB_URI=

# Optional: public application URL used in generated links.
APP_URL=
